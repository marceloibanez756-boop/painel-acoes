# Copie este arquivo para um arquivo chamado ".env" (sem o ".exemplo") e preencha com seus dados.
# O arquivo .env é lido apenas UMA VEZ: quando o app liga pela primeira vez e ainda não existe
# nenhum usuário cadastrado. Nesse momento ele cria o primeiro administrador com os dados abaixo.
# Depois disso, mudar este arquivo não muda mais o usuário administrador já criado.

# Porta em que o app vai rodar no seu computador (endereço: http://localhost:3000)
PORTA=3000

# Chave secreta usada para proteger o login. Troque por qualquer frase longa e aleatória.
CHAVE_SESSAO=troque-esta-frase-por-algo-so-seu-e-dificil-de-adivinhar

# Dados do primeiro administrador (só você usa isso, uma vez)
ADMIN_NOME=Seu Nome Completo
ADMIN_USUARIO=admin
ADMIN_EMAIL=seu@email.com
ADMIN_SENHA=troque-esta-senha
